# ============================================================
# Large project data
# ============================================================

# Raw source data and locally generated processed data
data/raw/*
data/processed/*

# Keep folder placeholders and data documentation under version control
!data/README.md
!data/raw/.gitkeep
!data/processed/.gitkeep


# ============================================================
# Trained models and large generated outputs
# ============================================================

# Ignore serialized model objects and large local output folders
models/
results/

# Examples of common saved-model formats
*.pkl
*.pickle
*.joblib
*.h5
*.keras


# ============================================================
# Python
# ============================================================

__pycache__/
*.py[cod]
*$py.class
*.so

# Build and package artifacts
build/
dist/
*.egg-info/
.eggs/
*.egg


# ============================================================
# Jupyter and IPython
# ============================================================

.ipynb_checkpoints/
profile_default/
ipython_config.py


# ============================================================
# Virtual environments and secrets
# ============================================================

.venv/
venv/
env/
ENV/
.env
.envrc


# ============================================================
# Testing, linting, and type checking
# ============================================================

.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/


# ============================================================
# IDE and operating-system files
# ============================================================

.DS_Store
Thumbs.db

.vscode/
.idea/
.spyderproject
.spyproject
.ropeproject

tempCodeRunnerFile.py


# ============================================================
# Local logs and temporary files
# ============================================================

*.log
*.tmp
*.temp
